# Agenda Digitale - configurazione. Compila i valori, poi lancia: npm run setup
# Backend dati: PocketBase sul VPS (vedi docs/admin/POCKETBASE.md). Valori di esempio, nessun segreto reale.

# URL HTTPS pubblico di PocketBase. Usato dal server Next (e dagli script) e dal browser per il realtime.
POCKETBASE_URL=https://pb.65-21-145-229.sslip.io
NEXT_PUBLIC_POCKETBASE_URL=https://pb.65-21-145-229.sslip.io

# Account di servizio: utente della collezione auth `app_services` creato dal pannello PocketBase (via Tailscale).
# Solo server: non usare mai NEXT_PUBLIC_ per queste variabili. Non sono un superuser.
POCKETBASE_SERVICE_EMAIL=
POCKETBASE_SERVICE_PASSWORD=

# Amministratore dell'app (creato o promosso dallo script di setup).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Peppe Moschetto"

# Notifiche push (web-push). Coppia di chiavi: npx web-push generate-vapid-keys
# La pubblica è esposta al browser, la privata solo al server. Se mancano, restano le notifiche in-app.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contatto per i servizi push: mailto: oppure https:
VAPID_SUBJECT=

# Promemoria giornalieri: il crontab del VPS invia "Authorization: Bearer $CRON_SECRET" a /api/cron/reminders.
CRON_SECRET=

# Solo per lo script di import una tantum dei menu da Notion (scripts/import-notion.mjs).
# Non servono all'esecuzione dell'app.
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_PIATTI_DATABASE_ID=
